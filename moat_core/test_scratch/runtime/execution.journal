{"type":"request","request_id":"a15d124b-f6bb-4c54-8397-0e1590240e6d","timestamp":1780715263,"agent_id":"tester","tool_name":"applescript","capability":"OsProcessSpawn","args":{"script":"\n            try\n                tell application \"System Events\"\n                    set frontApp to name of first application process whose frontmost is true\n                end tell\n            on error\n                set frontApp to \"\"\n            end try\n\n            if frontApp is \"Google Chrome\" or (application \"Google Chrome\" is running and frontApp is not \"Safari\") then\n                tell application \"Google Chrome\"\n                    if (count of windows) is 0 then return \"error: No Chrome windows open\"\n                    set activeTab to active tab of front window\n                    set tabUrl to URL of activeTab\n                    set tabTitle to title of activeTab\n                    try\n                        set tabText to execute activeTab javascript \"document.body.innerText\"\n                        return \"Browser: Chrome\\nURL: \" & tabUrl & \"\\nTitle: \" & tabTitle & \"\\nContent:\\n\" & tabText\n                    on error errMsg\n                        return \"Browser: Chrome\\nURL: \" & tabUrl & \"\\nTitle: \" & tabTitle & \"\\nError executing JavaScript: \" & errMsg & \". If using Chrome, please enable 'Allow JavaScript from Apple Events' in Chrome Menu -> View -> Developer.\"\n                    end try\n                end tell\n            else if frontApp is \"Safari\" or application \"Safari\" is running then\n                tell application \"Safari\"\n                    if (count of document) is 0 then return \"error: No Safari documents open\"\n                    set activeDoc to document 1\n                    set tabUrl to URL of activeDoc\n                    set tabTitle to name of activeDoc\n                    try\n                        if \"document.body.innerText\" is \"document.documentElement.outerHTML\" then\n                            set tabText to source of activeDoc\n                        else\n                            set tabText to text of activeDoc\n                        end if\n                        return \"Browser: Safari\\nURL: \" & tabUrl & \"\\nTitle: \" & tabTitle & \"\\nContent:\\n\" & tabText\n                    on error errMsg\n                        return \"Browser: Safari\\nURL: \" & tabUrl & \"\\nTitle: \" & tabTitle & \"\\nError: \" & errMsg\n                    end try\n                end tell\n            else\n                return \"error: Neither Chrome nor Safari is currently running or focused.\"\n            end if\n        "}}
{"type":"request","request_id":"f4ac9936-179f-435b-8724-c69768ec5a50","timestamp":1780716786,"agent_id":"tester","tool_name":"applescript","capability":"OsProcessSpawn","args":{"script":"\n            set output to \"\"\n            if application \"Google Chrome\" is running then\n                tell application \"Google Chrome\"\n                    repeat with w in windows\n                        repeat with t in tabs of w\n                            set output to output & \"Chrome -|- \" & (URL of t) & \" -|- \" & (title of t) & \"\\n\"\n                        end repeat\n                    end repeat\n                end tell\n            end if\n            if application \"Safari\" is running then\n                tell application \"Safari\"\n                    repeat with w in windows\n                        repeat with t in tabs of w\n                            set output to output & \"Safari -|- \" & (URL of t) & \" -|- \" & (name of t) & \"\\n\"\n                        end repeat\n                    end repeat\n                end tell\n            end if\n            return output\n        "}}
